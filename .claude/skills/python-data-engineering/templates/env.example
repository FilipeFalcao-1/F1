# Copiar para .env.example (versionado) e, localmente, para .env (NÃO versionado).
# Somente valores fictícios. Documente cada variável em docs/getting-started.md.

# Ambiente de execução: dev | hml | prd
APP_ENVIRONMENT=dev
# Nível de log: DEBUG | INFO | WARNING | ERROR
APP_LOG_LEVEL=INFO
# URL base da API de origem (obrigatória)
APP_API_BASE_URL=https://api.example.com/v1
# Token de acesso (obrigatório) — em produção, vem do gerenciador de segredos
APP_API_TOKEN=troque-me
# Diretório de saída dos dados processados
APP_OUTPUT_DIR=data/output
