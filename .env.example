# Copie para .env (NÃO versionado). Todas as variáveis são opcionais; os valores abaixo são os defaults.
# Documentação completa em docs/getting-started.md.

# URL base da OpenF1 API
F1_API_BASE_URL=https://api.openf1.org/v1
# Token da OpenF1 (só para planos pagos/apoiadores). Dados históricos não exigem token.
# F1_API_TOKEN=troque-me
# Raiz do data lake (bronze, silver, quarentena e f1.duckdb)
F1_DATA_DIR=data
# Limites de requisição (plano gratuito da OpenF1: 3 req/s e 30 req/min)
F1_RATE_LIMIT_PER_SECOND=3
F1_RATE_LIMIT_PER_MINUTE=30
# Novas tentativas em 429/5xx/timeout, com backoff exponencial e respeito ao Retry-After
F1_MAX_RETRIES=5
# Timeout por requisição, em segundos (a telemetria é grande)
F1_HTTP_TIMEOUT_SECONDS=60
# Tipos de sessão (session_type) com telemetria, separados por vírgula
F1_TELEMETRY_SESSION_TYPES=Race,Qualifying
# Nível de log: DEBUG | INFO | WARNING | ERROR
F1_LOG_LEVEL=INFO
